# ── Database ────────────────────────────────────────────────────────────
# Local SQLite by default. For Supabase, run `npm run use:supabase` first,
# then paste your Supabase connection URI (Project Settings → Database →
# Connection string → URI, Session-mode pooler, password filled in):
# DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
DATABASE_URL="file:./db/custom.db"

# ── Dashboard ───────────────────────────────────────────────────────────
# Initial owner password for the dashboard (used on first start only —
# change it later under Dashboard → Settings → Dashboard password).
OWNER_PASSWORD=pickora2026

# Secret used to sign session cookies — set a long random string (32+ chars).
APP_SECRET=change-me-to-a-long-random-string

# Canonical URL after deploy, e.g. https://your-store.vercel.app (optional).
NEXT_PUBLIC_SITE_URL=
